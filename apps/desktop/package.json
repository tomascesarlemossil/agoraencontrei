{
  "name": "@agoraencontrei/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema Administrador AgoraEncontrei — edição offline (instalável no Windows). Empacota a plataforma para rodar local com PostgreSQL embarcado e ativação por licença.",
  "main": "main.js",
  "author": "Imobiliária Lemos",
  "scripts": {
    "start": "electron .",
    "bundle": "node scripts/bundle-server.mjs",
    "assemble-api": "node scripts/assemble-offline-api.mjs",
    "dist": "electron-builder --win nsis",
    "dist:full": "node scripts/bundle-server.mjs && node scripts/assemble-offline-api.mjs && electron-builder --win nsis",
    "dist:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.agoraencontrei.software",
    "productName": "Sistema Administrador AgoraEncontrei",
    "artifactName": "AgoraEncontrei-Software-Setup.${ext}",
    "copyright": "© Imobiliária Lemos — AgoraEncontrei",
    "npmRebuild": false,
    "directories": { "output": "dist", "buildResources": "installer-assets" },
    "asar": false,
    "files": [
      "main.js", "preload.js", "license.js", "db.js", "renderer/**", "installer-assets/icon.ico", "node_modules/**",
      "!**/*.map", "!**/*.d.ts", "!**/*.md", "!**/*.markdown",
      "!**/__tests__/**", "!**/.github/**"
    ],
    "extraResources": [{
      "from": "server",
      "to": "server",
      "filter": [
        "**/*",
        "!**/*.map", "!**/*.d.ts",
        "!**/*.md", "!**/*.markdown",
        "!**/LICENSE*", "!**/LICENCE*", "!**/CHANGELOG*", "!**/README*", "!**/AUTHORS*",
        "!**/.github/**", "!**/__tests__/**", "!**/.nyc_output/**", "!**/coverage/**",
        "!**/libquery_engine-*", "!**/*query_engine-debian*", "!**/*query_engine-linux*",
        "!**/*query_engine-darwin*", "!**/*.dylib", "!**/*.so.node"
      ]
    }],
    "win": {
      "target": ["nsis"],
      "icon": "installer-assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema Administrador AgoraEncontrei",
      "installerIcon": "installer-assets/icon.ico",
      "uninstallerIcon": "installer-assets/icon.ico",
      "installerHeaderIcon": "installer-assets/icon.ico",
      "installerHeader": "installer-assets/installerHeader.bmp",
      "installerSidebar": "installer-assets/installerSidebar.bmp",
      "uninstallerSidebar": "installer-assets/installerSidebar.bmp"
    }
  },
  "devDependencies": {
    "electron": "^42.5.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "@embedded-postgres/windows-x64": "18.4.0-beta.17",
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  }
}
