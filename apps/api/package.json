{
  "name": "@agoraencontrei/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter @agoraencontrei/tomas-knowledge build",
    "build": "tsc --project tsconfig.build.json || true",
    "verify:boot": "node scripts/verify-route-imports.mjs",
    "start": "node dist/server.js",
    "pretypecheck": "pnpm --filter @agoraencontrei/tomas-knowledge build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@agoraencontrei/database": "workspace:*",
    "@agoraencontrei/tomas-knowledge": "workspace:*",
    "@anthropic-ai/sdk": "^0.104.1",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.108.2",
    "argon2": "^0.44.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "form-data": "^4.0.6",
    "google-auth-library": "^10.7.0",
    "ioredis": "^5.11.1",
    "nanoid": "^5.1.11",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.1",
    "openai": "^6.42.0",
    "pino-pretty": "^13.0.0",
    "playwright-core": "^1.61.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^6.4.23",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
